<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFF1F1F8" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFF9A3C" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FF9A9AB2" android:textSize="12sp" />
    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="46dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row"
        android:layout_marginTop="4dp" android:paddingStart="10dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/txt0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFF1F1F8" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/chk0" android:layout_width="44dp" android:layout_height="match_parent"
            android:gravity="center" android:textSize="18sp" android:textColor="#FF3DDC84" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="46dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row"
        android:layout_marginTop="4dp" android:paddingStart="10dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/txt1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFF1F1F8" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/chk1" android:layout_width="44dp" android:layout_height="match_parent"
            android:gravity="center" android:textSize="18sp" android:textColor="#FF3DDC84" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="46dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row"
        android:layout_marginTop="4dp" android:paddingStart="10dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/txt2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFF1F1F8" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/chk2" android:layout_width="44dp" android:layout_height="match_parent"
            android:gravity="center" android:textSize="18sp" android:textColor="#FF3DDC84" />
    </LinearLayout>
</LinearLayout>
